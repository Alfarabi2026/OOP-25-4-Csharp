@model WitcherWorld.Application.DTOs.RegisterUserDto

@{
    ViewData["Title"] = "Регистрация";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Регистрация | WitcherWorld</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
            body {
                background: linear-gradient(rgba(0,0,0,.85), rgba(0,0,0,.9)),
                            url('/images/witcher-bg.jpg') center/cover fixed;
                background-color: #151515;
                color: #eee;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: Georgia, serif;
            }

            .register-box {
                width: 100%;
                max-width: 460px;
                padding: 35px;
                background: rgba(20,20,20,.95);
                border: 1px solid #8b2525;
                box-shadow: 0 0 30px rgba(0,0,0,.8);
            }

            h1 {
                color: #c9a45c;
                text-align: center;
                margin-bottom: 25px;
            }

            .form-control {
                background: #292929;
                color: white;
                border: 1px solid #555;
                margin-bottom: 15px;
            }

            .form-control:focus {
                background: #333;
                color: white;
                border-color: #c9a45c;
                box-shadow: none;
            }

            .btn-witcher {
                background: #8b2525;
                color: white;
                width: 100%;
                border: none;
                padding: 12px;
            }

            .btn-witcher:hover {
                background: #b83232;
                color: white;
            }

            a { color: #c9a45c; }
    </style>
</head>
<body>
    <div class="register-box">
        <h1>WitcherWorld</h1>
        <h4 class="text-center mb-4">Создать аккаунт</h4>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <input asp-for="Username" class="form-control"
                   placeholder="Имя пользователя" />

            <input asp-for="Email" class="form-control"
                   placeholder="Электронная почта" />

            <input asp-for="Password" type="password" class="form-control"
                   placeholder="Пароль" />

            <input asp-for="ConfirmPassword" type="password"
                   class="form-control" placeholder="Повторите пароль" />

            <button type="submit" class="btn btn-witcher">
                Зарегистрироваться
            </button>
        </form>

        <p class="text-center mt-4">
            Уже есть аккаунт?
            <a asp-controller="Account" asp-action="Login">Войти</a>
        </p>
    </div>
</body>
</html>
