@model WitcherWorld.Application.DTOs.LoginUserDto

@{
    ViewData["Title"] = "Вход";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Вход | WitcherWorld</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
            body {
                background: linear-gradient(rgba(0,0,0,.85), rgba(0,0,0,.9)), url('/images/witcher-bg.jpg') center/cover fixed;
                background-color: #151515;
                color: #eee;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: Georgia, serif;
            }

            .login-box {
                width: 100%;
                max-width: 430px;
                padding: 35px;
                background: rgba(20,20,20,.95);
                border: 1px solid #8b2525;
                box-shadow: 0 0 30px rgba(0,0,0,.8);
            }

            h1 {
                color: #c9a45c;
                text-align: center;
                margin-bottom: 25px;
            }

            .form-control {
                background: #292929;
                color: white;
                border: 1px solid #555;
                margin-bottom: 18px;
            }

                .form-control:focus {
                    background: #333;
                    color: white;
                    border-color: #c9a45c;
                    box-shadow: none;
                }

            .btn-witcher {
                background: #8b2525;
                color: white;
                width: 100%;
                border: none;
                padding: 12px;
            }

                .btn-witcher:hover {
                    background: #b83232;
                    color: white;
                }

            a {
                color: #c9a45c;
            }
    </style>
</head>
<body>
    <div class="login-box">
        <h1>WitcherWorld</h1>
        <h4 class="text-center mb-4">Войти в аккаунт</h4>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <input asp-for="Login" class="form-control"
                   placeholder="Email или имя пользователя" />

            <input asp-for="Password" type="password"
                   class="form-control" placeholder="Пароль" />

            <button type="submit" class="btn btn-witcher">
                Войти
            </button>
        </form>

        <p class="text-center mt-4">
            Нет аккаунта?
            <a asp-controller="Account" asp-action="Register">
                Зарегистрироваться
            </a>
        </p>
    </div>
</body>
</html>
