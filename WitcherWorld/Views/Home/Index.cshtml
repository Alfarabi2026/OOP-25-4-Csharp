@model WitcherWorld.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Главная";
}

<style>
    .witcher-home {
        color: #e8e3d8;
    }

    .hero {
        min-height: 420px;
        display: flex;
        align-items: center;
        padding: 60px 40px;
        background: linear-gradient(90deg, rgba(0,0,0,.92), rgba(0,0,0,.35)), url('/images/witcher-bg.jpg') center/cover;
        border-radius: 8px;
        margin-bottom: 45px;
    }

        .hero h1 {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        .hero p {
            max-width: 600px;
            color: #c8c1b5;
            font-size: 1.1rem;
        }

    .section-title {
        text-transform: uppercase;
        letter-spacing: 2px;
        border-bottom: 2px solid #9b2525;
        padding-bottom: 12px;
        margin-bottom: 25px;
    }

    .character-card {
        height: 100%;
        background: #171717;
        border: 1px solid #393939;
        border-radius: 8px;
        overflow: hidden;
        transition: transform .2s, border-color .2s;
    }

        .character-card:hover {
            transform: translateY(-5px);
            border-color: #a52a2a;
        }

    .character-image {
        width: 100%;
        height: 260px;
        object-fit: cover;
        background: #292929;
    }

    .character-body {
        padding: 20px;
    }

        .character-body h3 {
            color: #d7b56d;
            font-size: 1.3rem;
        }

        .character-body p {
            color: #aaa;
        }

    .empty-message {
        color: #aaa;
        padding: 25px;
        background: #171717;
        border-radius: 8px;
    }
</style>

<div class="witcher-home">

    <section class="hero">
        <div>
            <h1>Witcher World</h1>

            <p>
                Погрузись в мир Ведьмака 3: исследуй Континент,
                познакомься с героями, изучай чудовищ,
                оружие, доспехи и легендарные задания.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-danger btn-lg">
                Исследовать мир
            </a>
        </div>
    </section>

    <section class="mb-5">
        <h2 class="section-title">Персонажи</h2>

        @if (Model.Characters.Count > 0)
        {
            <div class="row g-4">
                @foreach (var character in Model.Characters)
                {
                    <div class="col-md-6 col-lg-3">
                        <article class="character-card">

                            @if (!string.IsNullOrWhiteSpace(character.ImageUrl))
                            {
                                <img src="@character.ImageUrl"
                                     alt="@character.Name"
                                     class="character-image" />
                            }
                            else
                            {
                                <div class="character-image d-flex
                                    align-items-center justify-content-center">
                                    <span class="text-secondary">
                                        Изображение отсутствует
                                    </span>
                                </div>
                            }

                            <div class="character-body">
                                <h3>@character.Name</h3>

                                @if (!string.IsNullOrWhiteSpace(character.Title))
                                {
                                    <strong>@character.Title</strong>
                                }

                                <p class="mt-2">
                                    @character.Description
                                </p>
                            </div>

                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-message">
                Персонажи пока не добавлены.
            </div>
        }
    </section>

</div>
